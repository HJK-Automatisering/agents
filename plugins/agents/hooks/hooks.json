{
  "description": "Genkender projekt nul og manglende .gitignore ved sessionsstart",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/detect-project-zero.cjs"],
            "timeout": 10,
            "statusMessage": "Tjekker projektets tilstand"
          }
        ]
      }
    ]
  }
}
